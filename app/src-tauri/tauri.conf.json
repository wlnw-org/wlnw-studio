{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wildlife Network Studio",
  "version": "0.1.3",
  "identifier": "org.wlnw.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wildlife Network Studio",
        "width": 1320,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://tiles.openfreemap.org; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; child-src blob:; connect-src 'self' ipc: http://ipc.localhost https://tiles.openfreemap.org"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Process, review and publish wildlife recordings",
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "wlnw-studio",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2OTRDQjg0Mjc3MUI1QTAKUldTZ3RYRW5oTXVVMXFxMXRCMG5TRU01VjNhekx4ZStMay9DVm1USU53K1BUd0FmdjVhUnJjbEMK",
      "endpoints": [
        "https://github.com/wlnw-org/wlnw-studio/releases/latest/download/latest.json"
      ]
    }
  }
}
